# Copy to `.env` and fill in. Never commit the real `.env`.

DATA_DIR=data
HOST=0.0.0.0
PORT=8000

# The publishable key is safe in the browser. The secret key is not: it
# bypasses RLS, so it belongs only here and never in frontend/.env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed for the stored-credentials panel. Losing it makes
# those rows unrecoverable.
WEBCRAWLER_CREDENTIAL_KEY=
